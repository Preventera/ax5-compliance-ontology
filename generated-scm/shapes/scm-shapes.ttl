@prefix scm:  <https://agenticx5.com/ont/scm#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#####################################################################
# CONTRAINTES — Sémantique multi-systèmes — chaîne d'approvisionnement
#
# Chaque sévérité porte en commentaire le test qui l'a produite.
# Voir generator/severity_policy.py pour les trois tests.
#####################################################################

#--------------------------------------------------------------------
# SystemeSource
#--------------------------------------------------------------------
scm:SystemeSourceShape a sh:NodeShape ;
    sh:targetClass scm:SystemeSource ;

    sh:property [
        sh:path scm:nom ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'nom' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path scm:code ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'code' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] .

#--------------------------------------------------------------------
# ConceptSysteme
#--------------------------------------------------------------------
scm:ConceptSystemeShape a sh:NodeShape ;
    sh:targetClass scm:ConceptSysteme ;

    sh:property [
        sh:path scm:libelle ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'libelle' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path scm:scopedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class scm:SystemeSource ;
        sh:severity sh:Violation ;
        sh:message "Sans 'scopedTo', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path scm:definition ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'definition' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] .

