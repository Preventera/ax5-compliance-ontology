#--------------------------------------------------------------------
# Une application qui produit une décision individuelle sur un
# travailleur doit citer son encadrement juridique. Sans lui, le
# référentiel présente comme banale une application qui relève du
# profilage sous la Loi 25 et du haut risque sous l'AI Act.
#--------------------------------------------------------------------
iasst:EncadrementSiDecisionIndividuelleShape a sh:NodeShape ;
    sh:targetClass iasst:ApplicationIA ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Une application qui produit une décision individuelle sur un travailleur doit citer son encadrement juridique. Sans lui, le référentiel présente comme banale une application qui relève du profilage sous la Loi 25 et du haut risque sous l'AI Act." ;
        sh:prefixes iasst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/ia-sst#niveauDecision> "decision-individuelle" .
                FILTER NOT EXISTS { $this <https://agenticx5.com/ont/ia-sst#encadrePar> ?v }
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# L'application et son encadrement juridique doivent relever du
# même régime. Citer l'AI Act européen pour une application
# encadrée au Québec produit une réponse fluide et fausse.
#--------------------------------------------------------------------
iasst:ApplicationTraverseTechniqueEtDangerShape a sh:NodeShape ;
    sh:targetClass iasst:ApplicationIA ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "L'application et son encadrement juridique doivent relever du même régime. Citer l'AI Act européen pour une application encadrée au Québec produit une réponse fluide et fausse." ;
        sh:prefixes iasst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/ia-sst#scopedTo> ?a .
                $this <https://agenticx5.com/ont/ia-sst#encadrePar> / <https://agenticx5.com/ont/ia-sst#scopedTo> ?b .
                FILTER (?a != ?b)
            }
        """ ;
    ] .
