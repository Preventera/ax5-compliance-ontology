#--------------------------------------------------------------------
# TypeIntervention
#--------------------------------------------------------------------
iasst:TypeInterventionShape a sh:NodeShape ;
    sh:targetClass iasst:TypeIntervention ;

    sh:property [
        sh:path iasst:libelle ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'libelle' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path iasst:rangHierarchie ;
        sh:datatype xsd:integer ;
        sh:severity sh:Warning ;
        sh:message "De la donnée légitime peut ne pas avoir de 'rangHierarchie'. Bloquer rejetterait du vrai. On tolère et on suit le trou comme métrique de couverture." ;
        # TEST 2 : de la donnée légitime échouerait
    ] ;
    sh:property [
        sh:path iasst:rangHierarchie ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 5 ;
        sh:severity sh:Violation ;
        sh:message "Si «rangHierarchie» est renseigne, sa valeur doit rester dans les bornes. L absence est toleree; une valeur impossible ne l est pas." ;
        # Bornes : barriere dure meme quand la presence est un avertissement
    ] .

