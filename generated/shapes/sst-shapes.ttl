#--------------------------------------------------------------------
# ConceptLocal
#--------------------------------------------------------------------
sst:ConceptLocalShape a sh:NodeShape ;
    sh:targetClass sst:ConceptLocal ;

    sh:property [
        sh:path sst:libelle ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'libelle' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:scopedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sst:Juridiction ;
        sh:severity sh:Violation ;
        sh:message "Sans 'scopedTo', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] .

#--------------------------------------------------------------------
# Correspondance
#--------------------------------------------------------------------
sst:CorrespondanceShape a sh:NodeShape ;
    sh:targetClass sst:Correspondance ;

    sh:property [
        sh:path sst:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sst:ConceptLocal ;
        sh:severity sh:Violation ;
        sh:message "'source' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:cible ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sst:ConceptLocal ;
        sh:severity sh:Violation ;
        sh:message "'cible' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:mappingRelation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'mappingRelation' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:confidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:severity sh:Violation ;
        sh:message "Sans 'confidence', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:basis ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Sans 'basis', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:wasAttributedTo ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Sans 'wasAttributedTo', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] .

#--------------------------------------------------------------------
# On ne déclare pas une équivalence exacte entre deux régimes sur
# une preuve faible. C'est ainsi qu'on produit une réponse fluide
# et fausse.
#--------------------------------------------------------------------
sst:SeuilEquivalenceExacteShape a sh:NodeShape ;
    sh:targetClass sst:Correspondance ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "On ne déclare pas une équivalence exacte entre deux régimes sur une preuve faible. C'est ainsi qu'on produit une réponse fluide et fausse." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#mappingRelation> "exactMatch" .
                $this <https://agenticx5.com/ont/sst#confidence> ?v .
                FILTER (?v < 0.95)
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Une correspondance relie DEUX juridictions. Relier deux concepts
# du même régime n'a aucun sens : il n'y a rien à traduire.
#--------------------------------------------------------------------
sst:CorrespondanceTraverseLesRegimesShape a sh:NodeShape ;
    sh:targetClass sst:Correspondance ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Une correspondance relie DEUX juridictions. Relier deux concepts du même régime n'a aucun sens : il n'y a rien à traduire." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#source> / <https://agenticx5.com/ont/sst#scopedTo> ?a .
                $this <https://agenticx5.com/ont/sst#cible> / <https://agenticx5.com/ont/sst#scopedTo> ?b .
                FILTER (?a = ?b)
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Une obligation ne peut pas cesser d'être en vigueur avant d'y
# entrer.
#--------------------------------------------------------------------
sst:CoherenceDesDatesShape a sh:NodeShape ;
    sh:targetClass sst:Obligation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Une obligation ne peut pas cesser d'être en vigueur avant d'y entrer." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#validTo> ?_a .
                $this <https://agenticx5.com/ont/sst#validTo> ?v .
                $this <https://agenticx5.com/ont/sst#validFrom> ?ref .
                FILTER (?v <= ?ref)
            }
        """ ;
    ] .
