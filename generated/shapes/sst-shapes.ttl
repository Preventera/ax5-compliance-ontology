@prefix sst:  <https://agenticx5.com/ont/sst#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#####################################################################
# CONTRAINTES — Conformité SST Québec
#
# Chaque sévérité porte en commentaire le test qui l'a produite.
# Voir generator/severity_policy.py pour les trois tests.
#####################################################################

#--------------------------------------------------------------------
# Obligation
#--------------------------------------------------------------------
sst:ObligationShape a sh:NodeShape ;
    sh:targetClass sst:Obligation ;

    sh:property [
        sh:path sst:citation ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "Sans 'citation', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:enonce ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'enonce' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:statedIn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sst:Reglement ;
        sh:severity sh:Violation ;
        sh:message "Sans 'statedIn', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:validFrom ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Violation ;
        sh:message "Sans 'validFrom', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:recordedAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:severity sh:Violation ;
        sh:message "Sans 'recordedAt', la donnée produit une réponse fausse, pas seulement incomplète. Le coût d'une réponse de conformité erronée dépasse toujours le coût d'un blocage d'ingestion." ;
        # TEST 1 : produit une réponse fausse
    ] ;
    sh:property [
        sh:path sst:addressesHazard ;
        sh:minCount 1 ;
        sh:class sst:Danger ;
        sh:severity sh:Warning ;
        sh:message "De la donnée légitime peut ne pas avoir de 'addressesHazard'. Bloquer rejetterait du vrai. On tolère et on suit le trou comme métrique de couverture." ;
        # TEST 2 : de la donnée légitime échouerait
    ] .

#--------------------------------------------------------------------
# Reglement
#--------------------------------------------------------------------
sst:ReglementShape a sh:NodeShape ;
    sh:targetClass sst:Reglement ;

    sh:property [
        sh:path sst:titre ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "'titre' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] ;
    sh:property [
        sh:path sst:hasJurisdiction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sst:Juridiction ;
        sh:severity sh:Violation ;
        sh:message "'hasJurisdiction' est obligatoire, remplissable, et son absence rend la donnée inexploitable. Barrière dure justifiée." ;
        # Aucun test échoué : blocage sûr
    ] .

