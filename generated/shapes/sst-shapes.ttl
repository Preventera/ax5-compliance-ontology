#--------------------------------------------------------------------
# On ne déclare pas une équivalence exacte entre deux régimes sur
# une preuve faible. C'est ainsi qu'on produit une réponse fluide
# et fausse.
#--------------------------------------------------------------------
sst:SeuilEquivalenceExacteShape a sh:NodeShape ;
    sh:targetClass sst:Correspondance ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "On ne déclare pas une équivalence exacte entre deux régimes sur une preuve faible. C'est ainsi qu'on produit une réponse fluide et fausse." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#mappingRelation> "exactMatch" .
                $this <https://agenticx5.com/ont/sst#confidence> ?v .
                FILTER (?v < 0.95)
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Une correspondance relie DEUX juridictions. Relier deux concepts
# du même régime n'a aucun sens : il n'y a rien à traduire.
#--------------------------------------------------------------------
sst:CorrespondanceTraverseLesRegimesShape a sh:NodeShape ;
    sh:targetClass sst:Correspondance ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Une correspondance relie DEUX juridictions. Relier deux concepts du même régime n'a aucun sens : il n'y a rien à traduire." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#source> / <https://agenticx5.com/ont/sst#scopedTo> ?a .
                $this <https://agenticx5.com/ont/sst#cible> / <https://agenticx5.com/ont/sst#scopedTo> ?b .
                FILTER (?a = ?b)
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Une obligation ne peut pas cesser d'être en vigueur avant d'y
# entrer.
#--------------------------------------------------------------------
sst:CoherenceDesDatesShape a sh:NodeShape ;
    sh:targetClass sst:Obligation ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Une obligation ne peut pas cesser d'être en vigueur avant d'y entrer." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#validTo> ?_a .
                $this <https://agenticx5.com/ont/sst#validTo> ?v .
                $this <https://agenticx5.com/ont/sst#validFrom> ?ref .
                FILTER (?v <= ?ref)
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Cette obligation n'est couverte par aucun document interne. Ce
# n'est pas une erreur de donnée : c'est un TROU DE COUVERTURE.
# L'obligation est correctement encodée, mais rien dans le
# référentiel ne prétend la mettre en oeuvre. Avertissement plutôt
# que blocage — sinon on empêcherait d'encoder une obligation
# avant d'avoir écrit la procédure, ou on pousserait quelqu'un à
# inventer une couverture fictive.
#--------------------------------------------------------------------
sst:ObligationSansCouvertureShape a sh:NodeShape ;
    sh:targetClass sst:Obligation ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Cette obligation n'est couverte par aucun document interne. Ce n'est pas une erreur de donnée : c'est un TROU DE COUVERTURE. L'obligation est correctement encodée, mais rien dans le référentiel ne prétend la mettre en oeuvre. Avertissement plutôt que blocage — sinon on empêcherait d'encoder une obligation avant d'avoir écrit la procédure, ou on pousserait quelqu'un à inventer une couverture fictive." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?src <https://agenticx5.com/ont/sst#couvreObligation> $this }
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Une couverture déclarée complète doit avoir été revue par un
# humain. « complete » autorise un agent à considérer l'obligation
# comme satisfaite et à cesser de la signaler. Sur un jugement
# automatique non revu, c'est ainsi qu'on déclare conforme ce qui
# ne l'est pas.
#--------------------------------------------------------------------
sst:CouvertureCompleteExigeRevueShape a sh:NodeShape ;
    sh:targetClass sst:RevendicationCouverture ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Une couverture déclarée complète doit avoir été revue par un humain. « complete » autorise un agent à considérer l'obligation comme satisfaite et à cesser de la signaler. Sur un jugement automatique non revu, c'est ainsi qu'on déclare conforme ce qui ne l'est pas." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#degreCouverture> "complete" .
                $this <https://agenticx5.com/ont/sst#reviewStatus> ?v .
                FILTER (STR(?v) != "human-reviewed")
            }
        """ ;
    ] .

#--------------------------------------------------------------------
# Le document doit s'appliquer sur un site relevant du même régime
# que l'obligation qu'il prétend couvrir. Une procédure du site de
# Bromont ne couvre pas une obligation d'OSHA — même si elle
# traite du même sujet.
#--------------------------------------------------------------------
sst:CouvertureDansLeBonRegimeShape a sh:NodeShape ;
    sh:targetClass sst:RevendicationCouverture ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Le document doit s'appliquer sur un site relevant du même régime que l'obligation qu'il prétend couvrir. Une procédure du site de Bromont ne couvre pas une obligation d'OSHA — même si elle traite du même sujet." ;
        sh:prefixes sst: ;
        sh:select """
            SELECT $this
            WHERE {
                $this <https://agenticx5.com/ont/sst#parDocument> / <https://agenticx5.com/ont/sst#appliqueSur> / <https://agenticx5.com/ont/sst#scopedTo> ?a .
                $this <https://agenticx5.com/ont/sst#couvreObligation> / <https://agenticx5.com/ont/sst#statedIn> / <https://agenticx5.com/ont/sst#hasJurisdiction> ?b .
                FILTER (?a != ?b)
            }
        """ ;
    ] .
